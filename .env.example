# ── Infobip SMS Gateway Configuration ───────────────────────────────────────
INFOBIP_API_KEY=your_infobip_api_key_here
INFOBIP_BASE_URL=https://m963v6.api.infobip.com
INFOBIP_SENDER=InfoSMS

# HTTP Basic Auth for /sendsms.php legacy gateway
GATEWAY_USERNAME=your_username
GATEWAY_PASSWORD=your_password

# Admin credentials for GPS Tracker API
ADMIN_USER=your_admin_username
ADMIN_PWD=your_admin_password

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_at_least_32_chars
JWT_EXPIRES_IN=24h

# ── GPS Tracker Server (GT06 + HQ) ──────────────────────────────────────────
GT06_PORT=5022
TCP_KEEPALIVE_DELAY=600000
AUTO_ENFORCE_TRACKING=true
GPS_RAW_DEBUG=false

# ── HTTP Server ─────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── MySQL Database ──────────────────────────────────────────────────────────
DATABASE_HOST=140.238.88.183
DATABASE_PORT=3306
DATABASE_USER=tracker_user
DATABASE_PWD=your_db_password
DATABASE_NAME=tracker

# ── Redis Configuration (Command Queuing) ──────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ── Mobile App Version Check (seed values only; the API is source of truth) ──
APP_ANDROID_PACKAGE=com.etrack.sammycodes
APP_MIN_VERSION_ANDROID=1.0.0
APP_MIN_BUILD_ANDROID=
APP_LATEST_VERSION_ANDROID=1.0.0
APP_LATEST_BUILD_ANDROID=
APP_STORE_URL_ANDROID=
APP_IOS_BUNDLE_ID=
APP_MIN_VERSION_IOS=1.0.0
APP_MIN_BUILD_IOS=
APP_LATEST_VERSION_IOS=1.0.0
APP_LATEST_BUILD_IOS=
APP_STORE_URL_IOS=
# Play Store scrape tuning
PLAY_STORE_CACHE_TTL_MS=1800000
PLAY_STORE_TIMEOUT_MS=10000
