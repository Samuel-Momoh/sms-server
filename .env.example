# ── Infobip Credentials ──────────────────────────────────────────────────────
# Get these from: https://portal.infobip.com
INFOBIP_API_KEY=your_api_key_here
INFOBIP_BASE_URL=https://XXXXX.api.infobip.com
INFOBIP_SENDER=InfoSMS

# ── Gateway Auth ─────────────────────────────────────────────────────────────
# These are the username & password your portal sends in the gateway URL.
# Leave blank to skip auth validation (not recommended in production).
GATEWAY_USERNAME=admin
GATEWAY_PASSWORD=secret

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3000

# ── GPS Tracker (GT06 + HQ Protocols) ─────────────────────────────────────────
# TCP port the GPS tracker server listens on (supports both GT06 binary & HQ ASCII).
# Point your GPS tracker to this port.
GT06_PORT=5022

# TCP keepalive initial delay in milliseconds (default: 300000 = 5 minutes)
# Accommodates both active moving intervals (e.g. 30s) and stationary/sleep reporting intervals (e.g. 180s–300s).
TCP_KEEPALIVE_DELAY=300000

# Set to true to log incoming raw ASCII / hex packets (useful for debugging)
GPS_RAW_DEBUG=false

